{
  "ApiKeyAuth": {
    "Key": "sentinel-dev-key"
  },
  "ConnectionStrings": {
    "SentinelDb": "Data Source=sentinel.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Otel": {
    "OtlpEndpoint": "",
    "ConsoleExporter": true
  }
}
