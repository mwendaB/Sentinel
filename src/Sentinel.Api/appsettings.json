{
  "ApiKeyAuth": {
    "Key": "sentinel-dev-key"
  },
  "ConnectionStrings": {
    "SentinelDb": "Data Source=sentinel.db"
  },
  "Remediation": {
    "Enabled": true,
    "EnableServiceRestart": true,
    "EnableScaling": true,
    "EnableNotifications": true,
    "CommandTimeoutSeconds": 20,
    "NotificationLogPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
