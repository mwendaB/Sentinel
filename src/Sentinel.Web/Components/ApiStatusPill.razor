@using Sentinel.Web.Services
@implements IDisposable
@inject ApiClientStatus Status

@if (snapshot is not null)
{
    <div class="flex items-center gap-2 text-xs">
        <span class="h-2 w-2 rounded-full @DotClass"></span>
        <span class="text-slate-600 dark:text-slate-200">@Label</span>
    </div>
}

@code {
    private ApiStatusSnapshot? snapshot;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        snapshot = Status.Snapshot;
        Status.Updated += OnUpdated;
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void OnUpdated()
    {
        snapshot = Status.Snapshot;
        InvokeAsync(StateHasChanged);
    }

    private string DotClass => snapshot is null
        ? "bg-slate-400"
        : snapshot.Healthy
            ? "bg-emerald-500"
            : snapshot.InBackoff
                ? "bg-amber-500"
                : "bg-rose-500";

    private string Label
    {
        get
        {
            if (snapshot is null)
            {
                return "API: unknown";
            }

            if (snapshot.Healthy)
            {
                return "API: healthy";
            }

            if (snapshot.InBackoff && snapshot.NextRetryAt.HasValue)
            {
                var seconds = Math.Max(0, (snapshot.NextRetryAt.Value - DateTimeOffset.UtcNow).TotalSeconds);
                return $"Retrying in {seconds:F0}s (attempt {snapshot.RetryAttempt})";
            }

            return string.IsNullOrWhiteSpace(snapshot.LastError)
                ? "API: degraded"
                : $"API: {snapshot.LastError}";
        }
    }

    public void Dispose()
    {
        Status.Updated -= OnUpdated;
        _timer?.Dispose();
    }
}
