@page "/actions"

<PageTitle>Actions</PageTitle>

<div class="space-y-6">
    <header>
        <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Action History</h1>
        <p class="text-sm text-slate-500">Audit trail of automated remediation.</p>
    </header>

    <div class="sentinel-panel rounded-3xl p-6">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Latest Actions</h2>
            <button class="rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-white">Export CSV</button>
        </div>
        <div class="mt-4 space-y-3">
            <div class="grid grid-cols-4 gap-3 rounded-2xl border border-slate-100/60 bg-white/70 p-4 text-sm">
                <span class="text-slate-500">10:39:02</span>
                <span class="font-medium">Restarted nginx</span>
                <span class="text-emerald-600">Success</span>
                <span class="text-slate-500">95% confidence</span>
            </div>
            <div class="grid grid-cols-4 gap-3 rounded-2xl border border-slate-100/60 bg-white/70 p-4 text-sm">
                <span class="text-slate-500">10:31:47</span>
                <span class="font-medium">Scaled database</span>
                <span class="text-amber-600">In progress</span>
                <span class="text-slate-500">89% confidence</span>
            </div>
        </div>
    </div>
</div>
