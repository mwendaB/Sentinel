@page "/configuration"

<PageTitle>Configuration</PageTitle>

<div class="space-y-6">
    <header>
        <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Configuration</h1>
        <p class="text-sm text-slate-500">Manage ingestion, remediation, and notifications.</p>
    </header>

    <div class="grid gap-4 md:grid-cols-2">
        <div class="sentinel-panel rounded-3xl p-6">
            <h2 class="text-lg font-semibold">Log Sources</h2>
            <div class="mt-4 space-y-3 text-sm">
                <div class="flex items-center justify-between">
                    <span>Windows Event Log</span>
                    <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs text-emerald-700">Enabled</span>
                </div>
                <div class="flex items-center justify-between">
                    <span>journald</span>
                    <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs text-emerald-700">Enabled</span>
                </div>
            </div>
        </div>
        <div class="sentinel-panel rounded-3xl p-6">
            <h2 class="text-lg font-semibold">Notifications</h2>
            <div class="mt-4 space-y-3 text-sm">
                <div class="flex items-center justify-between">
                    <span>Slack</span>
                    <span class="rounded-full bg-slate-200 px-3 py-1 text-xs">Configured</span>
                </div>
                <div class="flex items-center justify-between">
                    <span>PagerDuty</span>
                    <span class="rounded-full bg-slate-200 px-3 py-1 text-xs">Configured</span>
                </div>
            </div>
        </div>
    </div>
</div>
