@page "/rules"

<PageTitle>Rules</PageTitle>

<div class="space-y-6">
    <header>
        <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Rule Manager</h1>
        <p class="text-sm text-slate-500">Visualize, test, and toggle automated rules.</p>
    </header>

    <div class="sentinel-panel rounded-3xl p-6">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Active Rules</h2>
            <button class="rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-white">Create Rule</button>
        </div>
        <div class="mt-4 space-y-3">
            <div class="rounded-2xl border border-slate-100/60 bg-white/70 p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-semibold">High latency on postgres</p>
                        <p class="text-xs text-slate-500">Regex: slow query detected</p>
                    </div>
                    <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs text-emerald-700">Enabled</span>
                </div>
            </div>
            <div class="rounded-2xl border border-slate-100/60 bg-white/70 p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-semibold">Nginx timeouts</p>
                        <p class="text-xs text-slate-500">Regex: connection timeout</p>
                    </div>
                    <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs text-emerald-700">Enabled</span>
                </div>
            </div>
        </div>
    </div>
</div>
