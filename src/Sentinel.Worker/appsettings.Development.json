{
  "Api": {
    "BaseUrl": "http://localhost:5104",
    "ApiKey": "sentinel-dev-key"
  },
  "Ingestion": {
    "FileTail": {
      "Enabled": true,
      "Paths": [
        "/var/log/syslog",
        "/var/log/system.log"
      ]
    },
    "Journald": {
      "Enabled": true
    },
    "MacUnified": {
      "Enabled": true
    },
    "WindowsEventLog": {
      "Enabled": true,
      "LogNames": [ "Application", "System" ],
      "PollIntervalSeconds": 4
    },
    "Syslog": {
      "Enabled": false,
      "BindAddress": "0.0.0.0",
      "Port": 5140
    },
    "Kafka": {
      "Enabled": false,
      "BootstrapServers": "localhost:9092",
      "GroupId": "sentinel-ingestion",
      "Topics": [ "sentinel-logs" ],
      "AutoOffsetReset": "Latest"
    },
    "Docker": {
      "Enabled": false,
      "Containers": [ "nginx", "redis" ],
      "SinceSeconds": 60,
      "IncludeTimestamps": true
    },
    "Kubernetes": {
      "Enabled": false,
      "Namespace": "default",
      "Pods": [ "api-0" ],
      "Container": null,
      "SinceSeconds": 60,
      "IncludeTimestamps": true
    },
    "Synthetic": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Otel": {
    "OtlpEndpoint": "",
    "ConsoleExporter": true
  }
}
